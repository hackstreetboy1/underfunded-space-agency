# Godot 4+ specific ignores
.godot/
/android/

# Secrets
.env
*.env
!.env.example

# .NET
bin/
obj/
*.user
TestResults/

# Python. backend/.venv is committed on purpose so the repo is the full package. It only runs on a PC with the same
# Python install; elsewhere Start-Demo builds a fresh environment.
__pycache__/
*.pyc
.pytest_cache/

# Exported builds (Godot export_presets.cfg writes to build/); anchored so pip's own build/ package stays in .venv
/build/

# Runtime logs (backend/cache is committed: cached NASA media and crew voice lines)
user_logs/

# Unused ElevenLabs SDK modules (chat agents, workspaces, service accounts, pronunciation dictionaries, dialogue,
# music plans) whose paths are too long for Windows to extract from a ZIP. The backend never loads them: it only uses
# text-to-speech, speech-to-text and the account check. A fresh pip install on another PC restores them.
