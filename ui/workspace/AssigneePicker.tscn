[gd_scene format=3]

[ext_resource type="Script" path="res://src/Game/UI/Workspace/AssigneePickerView.cs" id="picker"]
[ext_resource type="PackedScene" path="res://ui/workspace/AssigneeOption.tscn" id="option"]

[node name="AssigneePicker" type="PanelContainer"]
custom_minimum_size = Vector2(320, 0)
offset_right = 320.0
offset_bottom = 300.0
theme_type_variation = &"DialogPanel"
