[gd_scene format=3]

[ext_resource type="Script" path="res://src/Game/UI/Console/Components/ReadoutGroupView.cs" id="1_readoutgroupview"]
[ext_resource type="PackedScene" path="res://ui/console/components/ReadoutRow.tscn" id="2_readoutrow"]
[ext_resource type="PackedScene" path="res://ui/console/components/ArcGauge.tscn" id="3_arcgauge"]

[node name="ReadoutGroup" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_readoutgroupview")
RowScene = ExtResource("2_readoutrow")
GaugeScene = ExtResource("3_arcgauge")

[node name="Head" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Head"]
