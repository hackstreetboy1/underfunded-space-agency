-assets.nasa.gov/image/s66-34118/s66-34118~small.jpg","rel":"alternate","render":"image","width":640,"size":52000,"height":492},{"href":"https://images-assets.nasa.gov/image/s66-34118/s66-34118~thumb.jpg","rel":"preview","render":"image","width":640,"size":52000,"height":492},{"href":"https://images-assets.nasa.gov/image/s66-34118/s66-34118~large.jpg","rel":"alternate","render":"image","width":1920,"size":298000,"height":1477},{"href":"https://images-assets.nasa.gov/image/s66-34118/s66-34118~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-59990/collection.json","data":[{"center":"JSC","date_created":"1965-12-16T00:00:00Z","description":"S65-59990 (16 Dec. 1965) --- Crewmen of the aircraft carrier USS Wasp gather on deck to watch the recovery of the Gemini-6 spacecraft and astronauts. Note the signs hanging from the railings which say \"Seasons Greetings from WASP\" and \"Spirit of 76\". Photo credit: NASA or National Aeronautics and Space Administration","media_type":"image","nasa_id":"s65-59990","title":"Gemini-Titan (GT)-6 - Recovery - Spirit of '76 Sign - Atlantic"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-59990/s65-59990~medium.jpg","rel":"alternate","render":"image","width":1280,"size":215000,"height":995},{"href":"https://images-assets.nasa.gov/image/s65-59990/s65-59990~small.jpg","rel":"alternate","render":"image","width":640,"size":76000,"height":497},{"href":"https://images-assets.nasa.gov/image/s65-59990/s65-59990~thumb.jpg","rel":"preview","render":"image","width":640,"size":76000,"height":497},{"href":"https://images-assets.nasa.gov/image/s65-59990/s65-59990~large.jpg","rel":"alternate","render":"image","width":1920,"size":396000,"height":1493},{"href":"https://images-assets.nasa.gov/image/s65-59990/s65-59990~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-61825/collection.json","data":[{"center":"JSC","date_created":"1965-12-16T00:00:00Z","description":"S65-61825 (16 Dec. 1965) --- Astronauts Walter M. Schirra Jr. (left), command pilot, and Thomas P. Stafford, pilot, speak to crewmen onboard the aircraft carrier USS Wasp after successful recovery of the Gemini-6 spacecraft. Note the cake with a model of the Gemini spacecraft in its center, which is positioned in front of the astronauts. Photo credit: NASA or National Aeronautics and Space Administration","media_type":"image","nasa_id":"s65-61825","title":"GT-6"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-61825/s65-61825~medium.jpg","rel":"alternate","render":"image","width":841,"size":150000,"height":1280},{"href":"https://images-assets.nasa.gov/image/s65-61825/s65-61825~small.jpg","rel":"alternate","render":"image","width":420,"size":45000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-61825/s65-61825~thumb.jpg","rel":"preview","render":"image","width":420,"size":45000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-61825/s65-61825~large.jpg","rel":"alternate","render":"image","width":1261,"size":332000,"height":1920},{"href":"https://images-assets.nasa.gov/image/s65-61825/s65-61825~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s66-34101/collection.json","data":[{"center":"JSC","date_created":"1966-06-06T00:00:00Z","description":"S66-34101 (6 June 1966) --- The Gemini-9 spacecraft, with astronauts Thomas P. Stafford and Eugene A. Cernan still inside, is hoisted aboard the aircraft carrier USS Wasp. Gemini-9 splashed down only 3.5 miles from the big recovery ship at 9 a.m. (EST), June 6, 1966, 345 miles east of Cape Kennedy, to conclude a 72-hour, 21-minute mission in space. Photo credit: NASA","media_type":"image","nasa_id":"s66-34101","title":"GEMINI-TITAN (GT)-9A - RECOVERY - SPACECRAFT (S/C) HOISTED ABOARD - ATLANTIC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s66-34101/s66-34101~medium.jpg","rel":"alternate","render":"image","width":1280,"size":173000,"height":960},{"href":"https://images-assets.nasa.gov/image/s66-34101/s66-34101~small.jpg","rel":"alternate","render":"image","width":640,"size":52000,"height":480},{"href":"https://images-assets.nasa.gov/image/s66-34101/s66-34101~thumb.jpg","rel":"preview","render":"image","width":640,"size":52000,"height":480},{"href":"https://images-assets.nasa.gov/image/s66-34101/s66-34101~large.jpg","rel":"alternate","render":"image","width":1920,"size":360000,"height":1441},{"href":"https://images-assets.nasa.gov/image/s66-34101/s66-34101~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/S65-66703/collection.json","data":[{"center":"JSC","date_created":"1965-12-02T00:00:00Z","description":"S65-66703 (18 Dec. 1965) --- Astronaut James A. Lovell Jr., pilot of the National Aeronautics and Space Administration's Gemini-7 spaceflight, undergoes an eye examination during a postflight medical checkup aboard the aircraft carrier USS Wasp. Gemini-7 splashed down in the western Atlantic recovery area at 9:05 a.m. (EST) Dec. 16, 1965, after a 14-day mission in space. Photo credit: NASA","media_type":"image","nasa_id":"S65-66703","title":"ASTRONAUT JAMES A. LOVELL, JR.  - MEDICAL - PREFLIGHT (GEMINI-TITAN [GT]-7) - EYES EXAMINED - CAPE"}],"links":[{"href":"https://images-assets.nasa.gov/image/S65-66703/S65-66703~medium.jpg","rel":"alternate","render":"image","width":855,"size":161000,"height":1280},{"href":"https://images-assets.nasa.gov/image/S65-66703/S65-66703~small.jpg","rel":"alternate","render":"image","width":427,"size":43000,"height":640},{"href":"https://images-assets.nasa.gov/image/S65-66703/S65-66703~thumb.jpg","rel":"preview","render":"image","width":427,"size":43000,"height":640},{"href":"https://images-assets.nasa.gov/image/S65-66703/S65-66703~large.jpg","rel":"alternate","render":"image","width":1282,"size":370000,"height":1920},{"href":"https://images-assets.nasa.gov/image/S65-66703/S65-66703~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-61834/collection.json","data":[{"center":"JSC","date_created":"1965-12-18T00:00:00Z","description":"S65-61834 (18 Dec. 1965) --- Astronauts Frank Borman (left), Gemini-7 command pilot, and James A. Lovell Jr., pilot, take time out during their welcoming ceremonies aboard the aircraft carrier USS Wasp to autograph a life preserver. The National Aeronautics and Space Administration's Gemini-7 spacecraft splashed down in the western Atlantic recovery area at 9:05 a.m. (EST), Dec. 18, 1965, to conclude a highly successful 14-day mission in space. Photo credit: NASA","media_type":"image","nasa_id":"s65-61834","title":"GEMINI-TITAN (GT)-7 -  RECOVERY - ATLANTIC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-61834/s65-61834~medium.jpg","rel":"alternate","render":"image","width":1271,"size":161000,"height":1280},{"href":"https://images-assets.nasa.gov/image/s65-61834/s65-61834~small.jpg","rel":"alternate","render":"image","width":635,"size":48000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-61834/s65-61834~thumb.jpg","rel":"preview","render":"image","width":635,"size":48000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-61834/s65-61834~large.jpg","rel":"alternate","render":"image","width":1907,"size":361000,"height":1920},{"href":"https://images-assets.nasa.gov/image/s65-61834/s65-61834~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-63644/collection.json","data":[{"center":"JSC","date_created":"1965-12-18T00:00:00Z","description":"S65-63644 (18 Dec. 1965) --- Crewmen of the aircraft carrier USS Wasp gather on deck to watch the recovery of the National Aeronautics and Space Administration's Gemini-7 spacecraft and astronauts. Gemini-7, with astronauts Frank Borman, command pilot, and James A. Lovell Jr., pilot, splashed down in the western Atlantic at 9:05 a.m. (EST), Dec. 18, 1965, to conclude a record-breaking 14-day mission in space. Photo credit: NASA","keywords":["GEMINI 7 FLIGHT  GEMINI PROJECT  GEMINI SPACECRAFT  NAVY  PERSONNEL  SHIPS","SPACECRAFT RECOVERY  WATER LANDING"],"media_type":"image","nasa_id":"s65-63644","title":"GT-7 recovery"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-63644/s65-63644~medium.jpg","rel":"alternate","render":"image","width":1280,"size":266000,"height":1001},{"href":"https://images-assets.nasa.gov/image/s65-63644/s65-63644~small.jpg","rel":"alternate","render":"image","width":640,"size":86000,"height":500},{"href":"https://images-assets.nasa.gov/image/s65-63644/s65-63644~thumb.jpg","rel":"preview","render":"image","width":640,"size":86000,"height":500},{"href":"https://images-assets.nasa.gov/image/s65-63644/s65-63644~large.jpg","rel":"alternate","render":"image","width":1920,"size":505000,"height":1502},{"href":"https://images-assets.nasa.gov/image/s65-63644/s65-63644~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s66-15447/collection.json","data":[{"center":"JSC","date_created":"1966-12-18T00:00:00Z","description":"S66-15447 (18 Dec. 1965) --- Astronaut James A. Lovell Jr., pilot of the National Aeronautics Space Administration's 14-day Gemini-7 spaceflight, is hoisted from the water by a recovery helicopter from the aircraft carrier USS Wasp. Gemini-7 splashed down in the western Atlantic recovery area at 9:05 a.m. (EST), Dec. 18, 1965, to conclude the record-breaking mission in space. Astronaut Frank Borman, command pilot and three Navy frogmen sit in a life raft beside the spacecraft. Photo credit: NASA","media_type":"image","nasa_id":"s66-15447","title":"ASTRONAUT JAMES A. LOVELL, JR. - MISC. - GT-7 RECOVERY"}],"links":[{"href":"https://images-assets.nasa.gov/image/s66-15447/s66-15447~medium.jpg","rel":"alternate","render":"image","width":1280,"size":116000,"height":853},{"href":"https://images-assets.nasa.gov/image/s66-15447/s66-15447~small.jpg","rel":"alternate","render":"image","width":640,"size":33000,"height":426},{"href":"https://images-assets.nasa.gov/image/s66-15447/s66-15447~thumb.jpg","rel":"preview","render":"image","width":640,"size":33000,"height":426},{"href":"https://images-assets.nasa.gov/image/s66-15447/s66-15447~large.jpg","rel":"alternate","render":"image","width":1920,"size":251000,"height":1279},{"href":"https://images-assets.nasa.gov/image/s66-15447/s66-15447~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/S66-34109/collection.json","data":[{"center":"JSC","date_created":"1966-06-06T00:00:00Z","description":"S66-34109 (6 June 1966) --- Astronauts Thomas Stafford and Eugene Cernan (right) receive a warm welcome as they arrive aboard the prime recovery ship, the aircraft carrier USS Wasp.  John C. Stonesifer, with the Manned Spacecraft Center's Landing and Recovery Division, stands next to microphone at left. The Gemini-9 spacecraft can be seen in the right background of the view. Photo credit: NASA","media_type":"image","nasa_id":"S66-34109","title":"ASTRONAUT CERNAN, EUGENE A. - RECOVERY (GT-9A - WELCOME) - ATLANTIC"}],"links":[{"href":"https://images-assets.nasa.gov/image/S66-34109/S66-34109~medium.jpg","rel":"alternate","render":"image","width":837,"size":163000,"height":1280},{"href":"https://images-assets.nasa.gov/image/S66-34109/S66-34109~small.jpg","rel":"alternate","render":"image","width":418,"size":54000,"height":640},{"href":"https://images-assets.nasa.gov/image/S66-34109/S66-34109~thumb.jpg","rel":"preview","render":"image","width":418,"size":54000,"height":640},{"href":"https://images-assets.nasa.gov/image/S66-34109/S66-34109~large.jpg","rel":"alternate","render":"image","width":1255,"size":323000,"height":1920},{"href":"https://images-assets.nasa.gov/image/S66-34109/S66-34109~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-63646/collection.json","data":[{"center":"JSC","date_created":"1965-12-18T00:00:00Z","description":"S65-63646 (18 Dec. 1965) --- The crew of the Gemini-7 spaceflight, astronauts Frank Borman, command pilot, and James A. Lovell Jr., pilot, arrive aboard the aircraft carrier USS Wasp. The astronauts were picked up from the ocean, following successful splashdown, by recovery helicopter and flown to the carrier to begin postflight medical and technical debriefings. Photo credit: NASA","media_type":"image","nasa_id":"s65-63646","title":"Gemini-Titan (GT)-7 - Recovery - Atlantic"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-63646/s65-63646~medium.jpg","rel":"alternate","render":"image","width":1280,"size":208000,"height":1010},{"href":"https://images-assets.nasa.gov/image/s65-63646/s65-63646~small.jpg","rel":"alternate","render":"image","width":640,"size":61000,"height":505},{"href":"https://images-assets.nasa.gov/image/s65-63646/s65-63646~thumb.jpg","rel":"preview","render":"image","width":640,"size":61000,"height":505},{"href":"https://images-assets.nasa.gov/image/s65-63646/s65-63646~large.jpg","rel":"alternate","render":"image","width":1920,"size":421000,"height":1515},{"href":"https://images-assets.nasa.gov/image/s65-63646/s65-63646~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-61830/collection.json","data":[{"center":"JSC","date_created":"1965-12-18T00:00:00Z","description":"S65-61830 (18 Dec. 1965) --- Astronauts James A. Lovell Jr. (left), Gemini-7 pilot, and Frank Borman, command pilot, are shown just after they arrived aboard the aircraft carrier USS Wasp. Greeting the astronauts are Donald Stullken (at Lovell's right), Recovery Operations Branch, Landing and Recovery Division, Dr. Howard Minners (standing beside Borman), Flight Medicine Branch, Center Medical Office, Manned Spacecraft Center, and Bennett James (standing behind Borman), a NASA Public Affairs Officer. The National Aeronautics and Space Administration's Gemini-7 spacecraft splashed down in the western Atlantic recovery area at 9:05 a.m. (EST), Dec. 18, 1965, to conclude a record-breaking 14-day mission in space. Photo credit: NASA","media_type":"image","nasa_id":"s65-61830","title":"GT-7 RECOVERY"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-61830/s65-61830~medium.jpg","rel":"alternate","render":"image","width":854,"size":139000,"height":1280},{"href":"https://images-assets.nasa.gov/image/s65-61830/s65-61830~small.jpg","rel":"alternate","render":"image","width":427,"size":53000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-61830/s65-61830~thumb.jpg","rel":"preview","render":"image","width":427,"size":53000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-61830/s65-61830~large.jpg","rel":"alternate","render":"image","width":1282,"size":255000,"height":1920},{"href":"https://images-assets.nasa.gov/image/s65-61830/s65-61830~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-61823/collection.json","data":[{"center":"JSC","date_created":"1965-12-18T00:00:00Z","description":"S65-61823 (18 Dec. 1965) --- Astronauts James A. Lovell Jr. (left), Gemini-7 pilot, and Frank Borman (right), command pilot, slice into a huge cake which was part of their warm welcome after arriving aboard the aircraft carrier USS Wasp. The National Aeronautics and Space Administration's Gemini-7 spacecraft splashed down in the Western Atlantic recovery area at 9:05 a.m. (EST), Dec. 18, 1965, to conclude a highly successful 14-day mission in space. Sailors gather around close to watch the cake cutting. Photo credit: NASA","media_type":"image","nasa_id":"s65-61823","title":"GEMINI-TITAN (GT)-7 - RECOVERY - ATLANTIC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-61823/s65-61823~medium.jpg","rel":"alternate","render":"image","width":1280,"size":107000,"height":921},{"href":"https://images-assets.nasa.gov/image/s65-61823/s65-61823~small.jpg","rel":"alternate","render":"image","width":640,"size":38000,"height":460},{"href":"https://images-assets.nasa.gov/image/s65-61823/s65-61823~thumb.jpg","rel":"preview","render":"image","width":640,"size":38000,"height":460},{"href":"https://images-assets.nasa.gov/image/s65-61823/s65-61823~large.jpg","rel":"alternate","render":"image","width":1920,"size":203000,"height":1382},{"href":"https://images-assets.nasa.gov/image/s65-61823/s65-61823~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/S66-59981/collection.json","data":[{"center":"JSC","date_created":"1966-11-15T00:00:00Z","description":"S66-59981 (15 Nov. 1966) --- Astronauts James A. Lovell Jr. (left), command pilot, and Edwin E. Aldrin Jr., pilot, receive official welcome as they arrive aboard the aircraft carrier USS Wasp. Gemini-12 splashed down in the Atlantic Ocean recovery area at 2:21 p.m. (EST), Nov. 15, 1966, to conclude a four-day mission in space. Photo credit: NASA","media_type":"image","nasa_id":"S66-59981","title":"Gemini-Titan (GT)-12 Crew - Official Welcome - USS Wasp - Atlantic"}],"links":[{"href":"https://images-assets.nasa.gov/image/S66-59981/S66-59981~medium.jpg","rel":"alternate","render":"image","width":1280,"size":154000,"height":836},{"href":"https://images-assets.nasa.gov/image/S66-59981/S66-59981~small.jpg","rel":"alternate","render":"image","width":640,"size":51000,"height":418},{"href":"https://images-assets.nasa.gov/image/S66-59981/S66-59981~thumb.jpg","rel":"preview","render":"image","width":640,"size":51000,"height":418},{"href":"https://images-assets.nasa.gov/image/S66-59981/S66-59981~large.jpg","rel":"alternate","render":"image","width":1920,"size":306000,"height":1255},{"href":"https://images-assets.nasa.gov/image/S66-59981/S66-59981~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s66-34111/collection.json","data":[{"center":"JSC","date_created":"1966-06-06T00:00:00Z","description":"S66-34111 (6 June 1966) --- Astronauts Thomas P. Stafford (left) and Eugene A. Cernan talk to President Lyndon B. Johnson via ship-to-shore telephone from aboard the aircraft carrier USS Wasp. Gemini-9A splashed down only 3.5 miles from the recovery ship at 9 a.m. (EST), June 6, 1966, 345 miles east of Cape Kennedy, to conclude a 72-hour, 21-minute mission in space. Photo credit: NASA","media_type":"image","nasa_id":"s66-34111","title":"ASTRONAUT CERNAN, EUGENE A. - RECOVERY (GEMINI-TITAN [GT]-9A) - ATLANTIC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s66-34111/s66-34111~medium.jpg","rel":"alternate","render":"image","width":1280,"size":139000,"height":845},{"href":"https://images-assets.nasa.gov/image/s66-34111/s66-34111~small.jpg","rel":"alternate","render":"image","width":640,"size":44000,"height":422},{"href":"https://images-assets.nasa.gov/image/s66-34111/s66-34111~thumb.jpg","rel":"preview","render":"image","width":640,"size":44000,"height":422},{"href":"https://images-assets.nasa.gov/image/s66-34111/s66-34111~large.jpg","rel":"alternate","render":"image","width":1920,"size":298000,"height":1268},{"href":"https://images-assets.nasa.gov/image/s66-34111/s66-34111~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/S66-15802/collection.json","data":[{"center":"JSC","date_created":"1965-12-18T00:00:00Z","description":"S66-15802 (18 Dec. 1965) --- A camera on a recovery helicopter captured this scene as the Gemini-7 spacecraft slowly descends to the surface of the Atlantic Ocean to conclude a record-breaking 14-day mission in space. Aboard the spacecraft were astronauts Frank Borman, command pilot, and James A. Lovell Jr., pilot. Splashdown was at 9:05 a.m. (EST), Dec. 18, 1965. The two astronauts were hoisted from the water by a helicopter crew and flown to the aircraft carrier. Photo credit: NASA","media_type":"image","nasa_id":"S66-15802","title":"Recovery"}],"links":[{"href":"https://images-assets.nasa.gov/image/S66-15802/S66-15802~medium.jpg","rel":"alternate","render":"image","width":1280,"size":251000,"height":1012},{"href":"https://images-assets.nasa.gov/image/S66-15802/S66-15802~small.jpg","rel":"alternate","render":"image","width":640,"size":80000,"height":506},{"href":"https://images-assets.nasa.gov/image/S66-15802/S66-15802~thumb.jpg","rel":"preview","render":"image","width":640,"size":80000,"height":506},{"href":"https://images-assets.nasa.gov/image/S66-15802/S66-15802~large.jpg","rel":"alternate","render":"image","width":1920,"size":494000,"height":1519},{"href":"https://images-assets.nasa.gov/image/S66-15802/S66-15802~orig.jpg","rel":"canonical","render":"image"}]}],"metadata":{"total_hits":27},"links":[{"rel":"next","prompt":"Next","href":"http://images-api.nasa.gov/search?q=Gemini+aircraft+carrier+recovery&media_type=image&year_start=1965&year_end=1966&page_size=25&page=2"}]}}