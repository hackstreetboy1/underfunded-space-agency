39~medium.jpg","rel":"alternate","render":"image","width":1280,"size":106000,"height":1010},{"href":"https://images-assets.nasa.gov/image/s65-60039/s65-60039~small.jpg","rel":"alternate","render":"image","width":640,"size":35000,"height":505},{"href":"https://images-assets.nasa.gov/image/s65-60039/s65-60039~thumb.jpg","rel":"preview","render":"image","width":640,"size":35000,"height":505},{"href":"https://images-assets.nasa.gov/image/s65-60039/s65-60039~large.jpg","rel":"alternate","render":"image","width":1920,"size":217000,"height":1515},{"href":"https://images-assets.nasa.gov/image/s65-60039/s65-60039~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-30410/collection.json","data":[{"center":"JSC","date_created":"1965-06-03T00:00:00Z","description":"S65-30410 (3 June 1965) --- Overall view of the Mission Control Center in Houston, Texas, during the early hours of the Gemini-Titan 4 spaceflight. Photo credit: NASA","media_type":"image","nasa_id":"s65-30410","title":"MISSION CONTROL CENTER (MCC) ACTIVITY - GEMINI-TITAN (GT)-IV - MSC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-30410/s65-30410~medium.jpg","rel":"alternate","render":"image","width":1280,"size":166000,"height":891},{"href":"https://images-assets.nasa.gov/image/s65-30410/s65-30410~small.jpg","rel":"alternate","render":"image","width":640,"size":49000,"height":445},{"href":"https://images-assets.nasa.gov/image/s65-30410/s65-30410~thumb.jpg","rel":"preview","render":"image","width":640,"size":49000,"height":445},{"href":"https://images-assets.nasa.gov/image/s65-30410/s65-30410~large.jpg","rel":"alternate","render":"image","width":1920,"size":364000,"height":1337},{"href":"https://images-assets.nasa.gov/image/s65-30410/s65-30410~orig.jpg","rel":"canonical","render":"image","height":3209,"width":4606,"size":2800000}]},{"href":"https://images-assets.nasa.gov/image/s65-60037/collection.json","data":[{"center":"JSC","date_created":"1965-12-07T00:00:00Z","description":"S65-60037 (7 Dec. 1965) --- An overall view of the Manned Spacecraft Center's Mission Control Center, during the National Aeronautics and Space Administration's Gemini-7 spaceflight. Photo credit: NASA","media_type":"image","nasa_id":"s65-60037","title":"GEMINI-7 - MISSION OPERATIONS CONTROL ROOM (MOCR) - MISSION CONTROL CENTER (MCC) ACTIVITY - MSC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-60037/s65-60037~medium.jpg","rel":"alternate","render":"image","width":1280,"size":159000,"height":952},{"href":"https://images-assets.nasa.gov/image/s65-60037/s65-60037~small.jpg","rel":"alternate","render":"image","width":640,"size":52000,"height":476},{"href":"https://images-assets.nasa.gov/image/s65-60037/s65-60037~thumb.jpg","rel":"preview","render":"image","width":640,"size":52000,"height":476},{"href":"https://images-assets.nasa.gov/image/s65-60037/s65-60037~large.jpg","rel":"alternate","render":"image","width":1920,"size":328000,"height":1428},{"href":"https://images-assets.nasa.gov/image/s65-60037/s65-60037~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s66-43377/collection.json","data":[{"center":"JSC","date_created":"1966-07-18T00:00:00Z","description":"S66-43377 (18 July 1966) --- Standing at the flight director's console, viewing the Gemini-10 flight display in the Mission Control Center, are (left to right) William C. Schneider, Mission Director; Glynn Lunney, Prime Flight Director; Christopher C. Kraft Jr., MSC Director of Flight Operations; and Charles W. Mathews, Manager, Gemini Program Office. Photo credit: NASA","keywords":["FLIGHT CONTROL","FLIGHT OPERATIONS","GEMINI 10 FLIGHT","MISSION CONTROL","PERSONNEL"],"media_type":"image","nasa_id":"s66-43377","title":"Personnel - Gemini-Titan (GT)-10 - Mission Control Center (MCC) - MSC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s66-43377/s66-43377~medium.jpg","rel":"alternate","render":"image","width":1280,"size":14