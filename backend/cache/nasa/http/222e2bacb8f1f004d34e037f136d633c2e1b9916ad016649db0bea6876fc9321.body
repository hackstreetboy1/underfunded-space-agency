-22621~medium.jpg","rel":"alternate","render":"image","width":1279,"size":126000,"height":833},{"href":"https://images-assets.nasa.gov/image/s65-22621/s65-22621~small.jpg","rel":"alternate","render":"image","width":639,"size":33000,"height":416},{"href":"https://images-assets.nasa.gov/image/s65-22621/s65-22621~thumb.jpg","rel":"preview","render":"image","width":639,"size":33000,"height":416},{"href":"https://images-assets.nasa.gov/image/s65-22621/s65-22621~large.jpg","rel":"alternate","render":"image","width":1920,"size":309000,"height":1249},{"href":"https://images-assets.nasa.gov/image/s65-22621/s65-22621~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-13921/collection.json","data":[{"center":"JSC","date_created":"1965-01-06T00:00:00Z","description":"S65-13921 (1965) --- Overhead view of astronauts Walter M. Schirra Jr. (foreground), backup command pilot, and Thomas P. Stafford, backup pilot, as they prepare to run Gemini-Titan 3 simulations in the Gemini mission simulator in the Mission Control Center at Merritt Island, Florida.","media_type":"image","nasa_id":"s65-13921","title":"GEMINI-TITAN (GT)-III BACKUP CREW - TRAINING SIMULATOR  - CAPE"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-13921/s65-13921~medium.jpg","rel":"alternate","render":"image","width":1280,"size":159000,"height":997},{"href":"https://images-assets.nasa.gov/image/s65-13921/s65-13921~small.jpg","rel":"alternate","render":"image","width":640,"size":51000,"height":498},{"href":"https://images-assets.nasa.gov/image/s65-13921/s65-13921~thumb.jpg","rel":"preview","render":"image","width":640,"size":51000,"height":498},{"href":"https://images-assets.nasa.gov/image/s65-13921/s65-13921~large.jpg","rel":"alternate","render":"image","width":1920,"size":330000,"height":1496},{"href":"https://images-assets.nasa.gov/image/s65-13921/s65-13921~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s66-52762/collection.json","data":[{"center":"JSC","date_created":"1966-09-15T00:00:00Z","description":"S66-52762 (15 Sept. 1966) --- Dr. Robert R. Gilruth (left) smokes a cigar in Houston's Mission Control Center to celebrate the successful splashdown of Gemini-11. Looking on are James C. Elms (center), MSC deputy director, and Charles W. Mathews, Gemini program manager. Photo credit: NASA","media_type":"image","nasa_id":"s66-52762","title":"MCC During GT-11"}],"links":[{"href":"https://images-assets.nasa.gov/image/s66-52762/s66-52762~medium.jpg","rel":"alternate","render":"image","width":1280,"size":162000,"height":1280},{"href":"https://images-assets.nasa.gov/image/s66-52762/s66-52762~small.jpg","rel":"alternate","render":"image","width":640,"size":43000,"height":640},{"href":"https://images-assets.nasa.gov/image/s66-52762/s66-52762~thumb.jpg","rel":"preview","render":"image","width":640,"size":43000,"height":640},{"href":"https://images-assets.nasa.gov/image/s66-52762/s66-52762~large.jpg","rel":"alternate","render":"image","width":1920,"size":388000,"height":1920},{"href":"https://images-assets.nasa.gov/image/s66-52762/s66-52762~orig.jpg","rel":"canonical","render":"image","height":4481,"width":4481,"size":3600000}]},{"href":"https://images-assets.nasa.gov/image/s65-13920/collection.json","data":[{"center":"JSC","date_created":"1965-01-01T00:00:00Z","description":"S65-13920 (15 Jan. 1965) --- The Gemini-6 prime crew, astronauts Walter M. Schirra Jr. (left), command pilot, and Thomas P. Stafford, pilot, are pictured in the Gemini simulator during training exercises at the Mission Control Center at Cape Kennedy, Florida. Photo credit: NASA or National Aeronautics and Space Administration","media_type":"image","nasa_id":"s65-13920","title":"GEMINI-TITAN (GT)-III BACKUP CREW - SIMULATOR - CAPE"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-13920/s65-13920~medium.jpg","rel":"alternate","render":"image","width":1280,"size":176000,"height":1023},{"href":"https://images-assets.nasa.gov/image/s65-13920/s65-13920~small.jpg","rel":"alternate","render":"image","width":640,"size":54000,"height":511},{"href":"https://images-assets.nasa.gov/image/s65-13920/s65-13920~thumb.jpg","rel":"preview","render":"image","width":640,"size":54000,"height":511},{"href":"https://images-assets.nasa.gov/image/s65-13920/s65-13920~large.jpg","rel":"alternate","render":"image","width":1920,"size":382000,"height":1535},{"href":"https://images-assets.nasa.gov/image/s65-13920/s65-13920~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-13919/collection.json","data":[{"center":"JSC","date_created":"1965-01-15T00:00:00Z","description":"S65-13919 (15 Jan. 1965) --- Astronaut Walter M. Schirra Jr., command pilot of the Gemini-6 prime crew, is pictured in the cockpit of the Gemini simulator at the Mission Control Center at Cape Kennedy, Florida. Photo credit: NASA or National Aeronautics and Space Administration","media_type":"image","nasa_id":"s65-13919","title":"ASTRONAUT WALTER M. SCHIRRA, JR. - TRAINING - (SIMULATOR)"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-13919/s65-13919~medium.jpg","rel":"alternate","render":"image","width":1007,"size":187000,"height":1280},{"href":"https://images-assets.nasa.gov/image/s65-13919/s65-13919~small.jpg","rel":"alternate","render":"image","width":503,"size":57000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-13919/s65-13919~thumb.jpg","rel":"preview","render":"image","width":503,"size":57000,"height":640},{"href":"https://images-assets.nasa.gov/image/s65-13919/s65-13919~large.jpg","rel":"alternate","render":"image","width":1511,"size":387000,"height":1920},{"href":"https://images-assets.nasa.gov/image/s65-13919/s65-13919~orig.jpg","rel":"canonical","render":"image"}]},{"href":"https://images-assets.nasa.gov/image/s65-62062/collection.json","data":[{"center":"JSC","date_created":"1965-12-12T00:00:00Z","description":"S65-62062 (12 Dec. 1965) --- Discussing the scrubbing of the planned National Aeronautics and Space Administration?s Gemini-6 spaceflight are (from left) William C. Schneider (standing), deputy director, Gemini Program Office of Manned Spaceflight, NASA Headquarters, Washington, D.C.; Eugene F. Kranz (seated), white team flight director; Christopher C. Kraft Jr., red team flight director; and John D. Hodge, blue team flight director. The Gemini-6 mission has been rescheduled for Dec. 15, 1965. Photo credit: NASA or National Aeronautics and Space Administration","media_type":"image","nasa_id":"s65-62062","title":"MISSION CONTROL CENTER (MCC) - GEMINI-TITAN (GT)-6 ACTIVITY - MSC"}],"links":[{"href":"https://images-assets.nasa.gov/image/s65-62062/s65-62062~medium.jpg","rel":"alternate","render":"image","width":1280,"size":134000,"height":832},{"href":"https://images-assets.nasa.gov/image/s65-62062/s65-62062~small.jpg","rel":"alternate","render":"image","width":640,"size":40000,"height":416},{"href":"https://images-assets.nasa.gov/image/s65-62062/s65-62062~thumb.jpg","rel":"preview","render":"image","width":640,"size":40000,"height":416},{"href":"https://images-assets.nasa.gov/image/s65-62062/s65-62062~large.jpg","rel":"alternate","render":"image","width":1920,"size":299000,"height":1249},{"href":"https://images-assets.nasa.gov/image/s65-62062/s65-62062~orig.jpg","rel":"canonical","render":"image"}]}],"metadata":{"total_hits":40},"links":[{"rel":"next","prompt":"Next","href":"http://images-api.nasa.gov/search?q=Mission+Control+Center+Gemini&media_type=image&year_start=1965&year_end=1966&page_size=25&page=2"}]}}